# Postways v2 Development Environment Variables
#
# Usage:
# - Copy this file to `config/.env`
# - For production, use `env.prod.example` instead
#
# =============================================================================
# Django Core
# =============================================================================
DJANGO_ENV=development
DJANGO_SECRET_KEY=dev-secret-key-not-for-production

# =============================================================================
# Database (PostgreSQL)
# =============================================================================
# Docker Compose service name as host
DATABASE_URL=postgresql://admin:admin@db:5432/postways

# Postgres container initialization
POSTGRES_DB=postways
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin

# =============================================================================
# Redis
# =============================================================================
REDIS_HOST=redis
REDIS_PORT=6379

# =============================================================================
# Email (Optional)
# =============================================================================
# Leave unset to use console backend (prints emails to terminal)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=your-email@gmail.com
# WEEKLY_RECIPIENTS=you@example.com

# =============================================================================
# Grafana Cloud (Monitoring)
# =============================================================================
# Get these from: grafana.com → My Account → Prometheus → Send Metrics
GRAFANA_METRICS_URL=
GRAFANA_METRICS_USERNAME=
# Get these from: grafana.com → My Account → Loki → Send Logs
GRAFANA_LOGS_URL=
GRAFANA_LOGS_USERNAME=
# Single API key works for both (generate with "MetricsPublisher" + "LogsPublisher" scopes)
GRAFANA_API_KEY=
